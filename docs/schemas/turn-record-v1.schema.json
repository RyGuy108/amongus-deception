{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amongus:turn-record:v1",
  "title": "AmongUs structured agent turn",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "recorded_at",
    "experiment_id",
    "game_index",
    "turn_index",
    "timestep",
    "phase",
    "round",
    "player",
    "world_state_before",
    "observation",
    "incentive",
    "private_belief",
    "utterance",
    "atomic_claims",
    "action",
    "vote",
    "other_agent_beliefs",
    "model_metadata",
    "observation_location",
    "world_state_after"
  ],
  "properties": {
    "schema_version": {"const": "amongus.turn-record.v1"},
    "record_type": {"const": "agent_turn"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "experiment_id": {"type": "string", "minLength": 1},
    "game_index": {"type": "integer", "minimum": 0},
    "turn_index": {"type": "integer", "minimum": 0},
    "timestep": {"type": "integer", "minimum": 0},
    "phase": {"enum": ["task", "meeting"]},
    "round": {"type": ["integer", "null"]},
    "player": {
      "type": "object",
      "required": ["name", "color", "role", "personality"],
      "properties": {
        "name": {"type": "string"},
        "color": {"type": "string"},
        "role": {"enum": ["Crewmate", "Impostor"]},
        "personality": {"type": ["string", "null"]}
      }
    },
    "world_state_before": {"type": "object"},
    "observation": {"type": "object"},
    "incentive": {"type": "object"},
    "private_belief": {"type": "object"},
    "utterance": {"type": ["string", "null"]},
    "atomic_claims": {"type": "object"},
    "action": {"type": "object"},
    "vote": {"type": ["object", "null"]},
    "other_agent_beliefs": {"type": "object"},
    "model_metadata": {"type": "object"},
    "observation_location": {"type": ["string", "null"]},
    "world_state_after": {"type": "object"}
  }
}
