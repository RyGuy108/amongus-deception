{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amongus:activation-monitor-cost:v1",
  "title": "Phase 12 online activation-monitor cost measurement",
  "type": "object",
  "required": [
    "schema_version", "model", "activation_layer", "measurement_design",
    "input_tokens", "output_tokens", "latency_seconds",
    "mean_latency_seconds", "median_latency_seconds", "p95_latency_seconds",
    "measured_total_latency_seconds", "estimated_population_total_latency_seconds",
    "mean_forward_tokens", "scope", "calls"
  ],
  "properties": {
    "schema_version": {"const": "amongus.activation-monitor-cost.v1"},
    "model": {"type": "string"},
    "activation_layer": {"type": "integer", "minimum": 0},
    "measurement_design": {
      "type": "object",
      "required": [
        "warmup_discarded", "stratified_by_suite", "measured_call_count",
        "population_call_count", "seed", "device"
      ]
    },
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "latency_seconds": {"type": "number", "minimum": 0},
    "mean_latency_seconds": {"type": "number", "minimum": 0},
    "median_latency_seconds": {"type": "number", "minimum": 0},
    "p95_latency_seconds": {"type": "number", "minimum": 0},
    "measured_total_latency_seconds": {"type": "number", "minimum": 0},
    "estimated_population_total_latency_seconds": {"type": "number", "minimum": 0},
    "mean_forward_tokens": {"type": "number", "minimum": 0},
    "scope": {"type": "string"},
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sample_id", "suite", "latency_seconds", "prompt_tokens",
          "response_tokens"
        ]
      }
    }
  }
}
