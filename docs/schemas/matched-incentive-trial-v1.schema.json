{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amongus:matched-incentive-trial:v1",
  "title": "One condition sample in a matched incentive fork",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "experiment_id",
    "match_id",
    "game_index",
    "sequence",
    "repeat_index",
    "presentation_index",
    "phase",
    "round",
    "speaker",
    "model_metadata",
    "state_source",
    "frozen_context",
    "model_input",
    "invariant_fingerprint",
    "invariants",
    "manipulated_variable",
    "sampling_temperature",
    "design",
    "incentive",
    "status",
    "utterance",
    "response_format",
    "atomic_claims",
    "raw_response",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "amongus.matched-incentive-trial.v1"},
    "record_type": {"const": "matched_incentive_trial"},
    "experiment_id": {"type": "string"},
    "match_id": {"type": "string"},
    "game_index": {"type": "integer", "minimum": 0},
    "sequence": {"type": "integer", "minimum": 0},
    "repeat_index": {"type": "integer", "minimum": 0},
    "presentation_index": {"type": "integer", "minimum": 0},
    "phase": {"const": "meeting"},
    "round": {"type": ["integer", "null"]},
    "speaker": {"type": "object"},
    "model_metadata": {"type": "object"},
    "state_source": {"type": "string"},
    "frozen_context": {"type": "object"},
    "model_input": {
      "type": "object",
      "required": ["system_prompt", "user_prompt"],
      "properties": {
        "system_prompt": {"type": "string"},
        "user_prompt": {"type": "string"}
      }
    },
    "invariant_fingerprint": {"type": "string"},
    "invariants": {"type": "object"},
    "manipulated_variable": {"const": "incentive_condition"},
    "sampling_temperature": {"type": "number", "minimum": 0},
    "design": {"type": "object"},
    "incentive": {"type": "object"},
    "status": {"enum": ["collected", "invalid_response"]},
    "utterance": {"type": ["string", "null"]},
    "response_format": {"enum": ["json", "speak_action", "plain_text_recovery", "invalid"]},
    "atomic_claims": {"type": "object"},
    "raw_response": {"type": "string"},
    "error": {"type": ["string", "null"]}
  }
}
