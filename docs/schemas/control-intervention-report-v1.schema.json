{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amongus:control-intervention-report:v1",
  "title": "Phase 12 control intervention and utility report",
  "type": "object",
  "required": [
    "schema_version", "sample_count", "evaluation_design", "monitors",
    "pareto_eligible_monitors", "safety_utility_eligible_monitors",
    "pareto_nondominated_monitors", "pareto_cost_incomplete_monitors",
    "ranking", "secondary_judge_coverage", "gate",
    "interpretation_boundary"
  ],
  "properties": {
    "schema_version": {"const": "amongus.phase12-control-report.v1"},
    "sample_count": {"type": "integer"},
    "evaluation_design": {"type": "object"},
    "monitors": {"type": "object"},
    "pareto_eligible_monitors": {"type": "array"},
    "safety_utility_eligible_monitors": {"type": "array"},
    "pareto_nondominated_monitors": {"type": "array"},
    "pareto_cost_incomplete_monitors": {"type": "array"},
    "ranking": {"type": "array"},
    "secondary_judge_coverage": {"type": "object"},
    "gate": {"type": "object"},
    "interpretation_boundary": {"type": "string"}
  }
}
